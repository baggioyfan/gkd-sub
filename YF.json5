// 我的 GKD 订阅
// 改完规则后：把 version 加 1，再重新上传，设备才会拉到新内容
{
  "id": 9527,
  "name": "我的规则",
  "version": 10,
  "author": "YF",
  "categories": [],
  "globalGroups": [
    {
      "key": 0,
      "name": "关闭通知权限引导（通用）",
      "desc": "通用关闭「开启消息通知」类弹窗的「暂不开启」按钮，对所有 app 生效；需在 GKD 里启用全局规则后才生效",
      "actionMaximum": 1,
      "resetMatch": "app",
      "rules": [
        {
          "key": 0,
          // 暂不开启 文字独特，仅出现在通知/权限引导弹窗。兼容两类布局：
          //   红果类——文字在 TextView 子节点、可点是父容器，用父锚定；抖音类——文字节点本身可点，用本节点匹配
          "matches": "[text=\"暂不开启\"] < [clickable=true], [text=\"暂不开启\"][clickable=true]",
          "action": "clickNode"
        }
      ]
    }
  ],
  "apps": [
    {
      "id": "com.ss.android.ugc.aweme.lite",
      "name": "抖音极速版",
      "groups": [
        {
          "key": 0,
          "name": "关闭通知权限引导",
          "desc": "点掉「开启通知权限，高收益任务早知道」弹窗里的「暂不开启」",
          "actionMaximum": 1,
          "resetMatch": "app",
          "rules": [
            {
              "key": 0,
              // 通知弹窗可能在多个页面弹出，不限 Activity；[text="暂不开启"] 文字独特，不会误点别的弹窗
              "matches": "[text=\"暂不开启\"][clickable=true]",
              "action": "clickNode"
            }
          ]
        }
      ]
    },
    {
      "id": "com.ct.client",
      "name": "中国电信",
      "groups": [
        {
          "key": 0,
          "name": "关闭口令红包浮层",
          "desc": "先勾上「7天内不再提示」，再点右上角关闭",
          "actionMaximum": 2,
          "resetMatch": "app",
          "rules": [
            {
              "key": 0,
              // 只在未勾选时点，避免把已经勾上的又取消掉
              "activityIds": "com.ct.client.activity.MainActivity",
              "matches": "[vid=\"cbNoMore\"][checked=false]",
              "action": "clickNode"
            },
            {
              "key": 1,
              "activityIds": "com.ct.client.activity.MainActivity",
              "matches": "[vid=\"close\"][clickable=true]",
              "action": "clickNode"
            }
          ]
        },
        {
          "key": 1,
          "name": "关闭推送通知引导",
          "desc": "点掉「开启推送通知」弹窗里的「暂不」，跳过推送通知请求",
          "actionMaximum": 1,
          "resetMatch": "app",
          "rules": [
            {
              "key": 0,
              // 这个推送通知弹窗会在多个页面弹出，所以不限 Activity；用标题「开启推送通知」锚定，只点这个弹窗里的「暂不」，避免误点别的弹窗
              "matches": "TextView[text^=\"开启推送通知\"] < LinearLayout > LinearLayout > TextView[text=\"暂不\"][clickable=true]",
              "action": "clickNode"
            }
          ]
        }
      ]
    },
    {
      "id": "com.greenpoint.android.mc10086.activity",
      "name": "中国移动",
      "groups": [
        {
          "key": 0,
          "name": "关闭爱看签到浮层",
          "desc": "先勾上「不再提醒」，再点右下角关闭",
          "actionMaximum": 2,
          "resetMatch": "app",
          "rules": [
            {
              "key": 0,
              // 勾选框是外层容器，ImageView 本身不可点，所以点容器
              "activityIds": "com.mc10086.cmcc.view.tabs.AppTabFragment",
              "matches": "[vid=\"layout_default_select\"][clickable=true]",
              "action": "clickNode"
            },
            {
              "key": 1,
              "activityIds": "com.mc10086.cmcc.view.tabs.AppTabFragment",
              "matches": "[vid=\"close_btn\"][clickable=true]",
              "action": "clickNode"
            }
          ]
        }
      ]
    },
    {
      "id": "com.jingdong.app.mall",
      "name": "京东",
      "groups": [
        {
          "key": 0,
          "name": "关闭通知权限引导",
          "desc": "点掉「开启消息通知」弹窗里的「关闭」，跳过通知权限请求",
          "actionMaximum": 1,
          "resetMatch": "app",
          "rules": [
            {
              "key": 0,
              // 通知弹窗可能在多个页面弹出，不限 Activity；matches 已用标题「开启消息通知」锚定，删掉 activityIds 后全页面生效且不会误点
              // 关闭按钮(desc=关闭)是内容框的兄弟节点：从标题文字上溯两层容器再下钻到关闭按钮
              // 用 * 抗类名重构；别用 vid=be8，那是混淆 id，会随版本变
              "matches": "TextView[text^=\"开启消息通知\"] < * < * > ImageView[desc=\"关闭\"]",
              "action": "clickNode"
            }
          ]
        }
      ]
    },
    {
      "id": "com.phoenix.read",
      "name": "红果免费短剧",
      "groups": [
        {
          "key": 0,
          "name": "关闭通知权限引导",
          "desc": "点掉「开启消息通知」弹窗里的「暂不开启」，跳过通知权限请求",
          "actionMaximum": 1,
          "resetMatch": "app",
          "rules": [
            {
              "key": 0,
              // 通知权限引导弹窗，不限 Activity；点「暂不开启」跳过。「暂不开启」文字在 TextView 子节点，故锚定其可点击父容器
              "matches": "TextView[text=\"暂不开启\"] < [clickable=true]",
              "action": "clickNode"
            }
          ]
        }
      ]
    },
    {
      // 从线上 gkd.325500.xyz 同步合并（本地之前分叉缺失）
      "id": "com.zcshou.gogogo",
      "name": "影梭",
      "groups": [
        {
          "key": 0,
          "name": "自动进入应用",
          "desc": "启动欢迎页：协议没勾先勾上，再点「进入应用」，跳过启动页",
          "actionMaximum": 2,
          "resetMatch": "app",
          "rules": [
            {
              "key": 0,
              "activityIds": "com.zcshou.gogogo.WelcomeActivity",
              "matches": "[vid=\"check_agreement\"][checked=false]",
              "action": "clickNode"
            },
            {
              "key": 1,
              "activityIds": "com.zcshou.gogogo.WelcomeActivity",
              "matches": "[vid=\"startButton\"][clickable=true]",
              "action": "clickNode"
            }
          ]
        }
      ]
    }
  ]
}
