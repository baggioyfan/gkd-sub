// 我的 GKD 订阅
// 改完规则后：把 version 加 1，再重新上传，设备才会拉到新内容
{
  "id": 9527,
  "name": "我的规则",
  "version": 1,
  "author": "YF",
  "categories": [],
  "globalGroups": [],
  "apps": [
    {
      "id": "com.ss.android.ugc.aweme.lite",
      "name": "抖音极速版",
      "groups": [
        {
          "key": 0,
          "name": "关闭通知权限引导",
          "desc": "点掉「开启通知权限，高收益任务早知道」弹窗里的「暂不开启」",
          "actionMaximum": 1,
          "resetMatch": "app",
          "rules": [
            {
              "key": 0,
              // 限定界面，防止在别的页面误点；弹窗换 Activity 时删掉这行即可
              "activityIds": "com.ss.android.ugc.aweme.main.MainActivity",
              "matches": "[text=\"暂不开启\"][clickable=true]",
              "action": "clickNode"
            }
          ]
        }
      ]
    }
  ]
}
